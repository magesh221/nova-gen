NODE_ENV=development
PORT=8690
TRUST_PROXY=false
MONGODB_URI=mongodb://127.0.0.1:27017/nova_ai
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# OpenAI-compatible chat completions endpoint (OpenRouter works here too).
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=replace-with-your-server-side-provider-key
AI_MODEL=openai/gpt-4o-mini
AI_CONTEXT_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=1500
AI_TIMEOUT_MS=60000

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_DAILY_MESSAGE_LIMIT=100

# SMTP settings are required to deliver password-reset links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Nova AI <no-reply@example.com>
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
